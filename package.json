{
  "name": "humans-md-plugins",
  "private": true,
  "description": "Source of the single-person HUMANS.md CLI, its plugins and the @humans-md/cli npm package.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "gen": "node scripts/sync-spec.mjs --check && node core/scripts/gen-validator.ts",
    "build": "npm run gen && node scripts/build.ts",
    "test": "npm run test:core && npm run test:public",
    "test:core": "npm run gen && vitest run --root core",
    "test:public": "node --test 'test/*.test.mjs'",
    "typecheck": "npm run gen && tsc -p core/tsconfig.json",
    "check:spec": "node scripts/sync-spec.mjs --check --require-pinned",
    "sync:spec": "node scripts/sync-spec.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "yaml": "2.9.1"
  }
}
