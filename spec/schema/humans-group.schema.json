        },
        "group_by": {
          "enum": [
            "project",
            "none"
          ]
        },
        "channel_hint": {
          "enum": [
            "async_written",
            "sync_call",
            "either"
          ]
        },
        "progress_updates": {
          "enum": [
            "every_message",
            "phase_changes",
            "end_only"
          ],
          "description": "How a long task reports where it stands in its own conversation; never a reason to message elsewhere."
        }
      },
      "minProperties": 1
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "knows_well": {
          "type": "array",
          "maxItems": 15,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/topic"
          },
          "minItems": 1,
          "description": "Intersection over every eligible member; absent or empty list prevents a common-knowledge claim."
        },
        "knows_little": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/topic"
          },
          "minItems": 1,
          "maxItems": 81
