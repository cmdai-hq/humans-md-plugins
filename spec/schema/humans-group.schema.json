{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humansmd.dev/schema/0.3/humans-group.schema.json",
  "title": "Experimental merged HUMANS.md profile, version 0.3 (draft)",
  "description": "Deterministic experimental output under SPEC § 9. No active state, identity, notes, anonymity, presence or orchestration guarantee. Cross-field counts and exact merge behavior also require procedural checks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "humans_group",
    "coverage",
    "conflicts"
  ],
  "properties": {
    "humans_group": {
      "const": "0.3"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "with_profile",
        "total"
      ],
      "properties": {
        "with_profile": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "stale": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/language"
      },
      "minItems": 1,
      "uniqueItems": true,
      "maxItems": 10
    },
    "reading": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lead_with": {
          "enum": [
            "tldr",
            "decision_needed",
            "context",
            "question",
            "next_action"
          ],
          "description": "What the first line holds."
        },
        "length": {
          "enum": [
            "minimal",
            "short",
            "standard",
            "thorough"
          ]
        },
        "max_words": {
          "type": "integer",
          "minimum": 20,
          "maximum": 2000,
          "description": "Cap on the entire message, including an appendix, tables and code; never bypass via an unsolicited thread or extra message."
        },
        "structure": {
          "enum": [
            "bullets",
            "prose",
            "mixed",
            "numbered"
          ]
        },
        "visual": {
          "type": "array",
          "items": {
            "enum": [
              "table",
              "diagram",
              "chart",
              "example",
              "text"
            ]
          },
          "uniqueItems": true,
          "maxItems": 2,
          "description": "Preferred forms, most wanted first.",
          "minItems": 1
        },
        "technical_depth": {
          "enum": [
            "non_technical",
            "balanced",
            "expert"
          ]
        },
        "jargon": {
          "enum": [
            "avoid",
            "define",
            "ok"
          ]
        },
        "tone": {
          "enum": [
            "direct",
            "neutral",
            "warm"
          ]
        },
        "evidence": {
          "enum": [
            "numbers_and_sources",
            "key_numbers",
            "light"
          ]
        },
        "uncertainty": {
          "enum": [
            "flag_explicitly",
            "inline"
          ],
          "description": "flag_explicitly: say what was checked and what was assumed."
        },
        "close_with": {
          "enum": [
            "next_action",
            "one_question",
            "nothing"
          ],
          "description": "What the last line holds; never invent an action or a question to fill it."
        },
        "appendix_depth": {
          "enum": [
            "balanced",
            "expert"
          ],
          "description": "Optional depth for separately requested details or an appendix within the same whole-message max_words cap."
        }
      },
      "minProperties": 1
    },
    "deciding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reversible": {
          "enum": [
            "decide_and_report",
            "ask"
          ],
          "description": "Only for actions the agent is already allowed to take. Never grants a permission."
        },
        "batch_questions": {
          "enum": [
            "end_of_task",
            "as_they_come"
          ]
        },
        "default_answer": {
          "enum": [
            "always",
            "when_obvious"
          ]
        },
        "asks_per_message": {
          "enum": [
            "one",
            "few",
            "any"
          ]
        },
        "format": {
          "enum": [
            "recommendation_first",
            "options_then_recommendation",
            "options_only"
          ]
        },
        "question_style": {
          "enum": [
            "open",
            "multiple_choice",
            "yes_confirms_recommendation"
          ],
          "description": "How each question is phrased; yes_confirms_recommendation falls back to multiple_choice without a recommendation."
        },
        "challenge": {
          "enum": [
            "welcome_early",
            "after_draft",
            "on_request"
          ]
        },
        "out_of_scope_steps": {
          "enum": [
            "omit_unless_blocking",
            "list"
          ]
        }
      },
      "minProperties": 1
    },
    "interrupting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interrupt_for": {
          "enum": [
            "blocking_only",
            "blocking_or_risky",
            "anything"
