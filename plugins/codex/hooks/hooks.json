{
  "description": "Load the owner's ~/.humans/HUMANS.md as presentation data at session start.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/session-start.mjs\"",
            "timeout": 10,
            "statusMessage": "Loading your HUMANS.md",
            "additionalContextLimit": 16384
          }
        ]
      }
    ]
  }
}
